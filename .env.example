# Claude credentials. Set one of the two.
# An API key from the Claude Console.
ANTHROPIC_API_KEY=
# A Claude subscription token, printed by `claude setup-token`. For your own personal use only:
# Anthropic doesn't allow products used by others to run on a claude.ai login or subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# The Claude model the agent runs on. Defaults to claude-opus-5-5.
AGENT_MODEL=

# The Ohara MCP server the agent reads docs from, such as https://ohara.example.com/docs/mcp.
# Leave empty to run the agent without tools.
OHARA_MCP_URL=
# A GitHub or oha_ token for Ohara. Needed only when the docs repository is private.
# Without it, Ohara answers 401 and the agent runs without its tools. `gh auth token` prints a GitHub token.
OHARA_TOKEN=

# The path the app is served under, such as /agent. Leave empty to serve it at the root.
BASE_PATH=
